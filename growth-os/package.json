{
  "name": "rank-logic-growth-os",
  "version": "0.1.0",
  "private": true,
  "description": "Rank Logic Growth OS - internal multi-client agency app: CRM, content, websites, SEO, reporting",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "prisma generate && next build",
    "start": "next start -p 3100",
    "worker": "tsx src/worker/index.ts",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed": "tsx prisma/seed.ts",
    "setup": "prisma generate && prisma migrate deploy && npm run db:seed",
    "screens": "node scripts/screens.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@fontsource-variable/schibsted-grotesk": "5.3.0",
    "@prisma/client": "6.16.2",
    "bcryptjs": "3.0.2",
    "cheerio": "1.1.2",
    "clsx": "2.1.1",
    "lucide-react": "0.544.0",
    "next": "15.5.28",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "server-only": "0.0.1",
    "tsx": "4.20.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.18.1",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "autoprefixer": "10.4.21",
    "axe-core": "4.14.0",
    "eslint": "9.35.0",
    "eslint-config-next": "15.5.28",
    "postcss": "8.5.31",
    "prisma": "6.16.2",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  },
  "overrides": {
    "postcss": "8.5.31",
    "effect": "3.22.3",
    "deepmerge-ts": "8.0.2",
    "sharp": "0.35.5"
  }
}
