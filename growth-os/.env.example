# Names only. Never commit values. Copy to .env and fill in locally.
DATABASE_URL=
DIRECT_URL=
# Test database (separate from dev). Tests refuse to run against DATABASE_URL.
TEST_DATABASE_URL=
# 32+ random bytes, base64. Signs sessions and derives the token-encryption key.
AUTH_SECRET=
# Public origin of this app, e.g. http://localhost:3100
APP_ORIGIN=
# Password for the local demo accounts created by `npm run db:seed` (12+ characters).
SEED_PASSWORD=
# Live switches. All default OFF. Turning one on requires a recorded approval (replica/backend.md).
LIVE_SENDING_ENABLED=
LIVE_PUBLISHING_ENABLED=
AI_LIVE_ENABLED=
# AI provider (optional). Absent -> deterministic templates, labelled "Template".
ANTHROPIC_API_KEY=
AI_MODEL=
