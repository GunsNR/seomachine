# ---------------------------------------------------------------------------
# Rank Logic SuperTool — environment
# Copy to .env and fill in. Only DATABASE_URL and AUTH_SECRET are required.
# ---------------------------------------------------------------------------

# SQLite by default so the app runs with zero infrastructure.
# For Postgres: change the provider in prisma/schema.prisma and use a
# postgresql:// URL here.
DATABASE_URL="file:./dev.db"

# Signs session cookies. Must be at least 32 characters.
# Generate one with: openssl rand -base64 48
AUTH_SECRET=""

# Canonical origin, used for sitemap URLs, canonical tags and OG images.
NEXT_PUBLIC_SITE_URL="https://ranklogicsupertool.com"

# ---------------------------------------------------------------------------
# Answer engine credentials (all optional)
#
# Each engine runs live when its key is present and falls back to the built-in
# deterministic simulator when it is not. The dashboard labels simulated data
# explicitly, so a partial configuration is a valid state — not a broken one.
# ---------------------------------------------------------------------------

# ChatGPT
OPENAI_API_KEY=""

# Perplexity
PERPLEXITY_API_KEY=""

# Claude
ANTHROPIC_API_KEY=""

# Gemini and Google AI Mode
GOOGLE_AI_API_KEY=""

# Grok
XAI_API_KEY=""

# Google AI Mode via a SERP provider (optional; falls back to Gemini)
SERP_API_KEY=""
