# ---------------------------------------------------------------------------
# Rank Logic SuperTool — environment
#
# Copy to .env and fill in. Only DATABASE_URL and AUTH_SECRET are required;
# everything else adds capability.
#
# Without an answer-engine key the product still runs, but it measures nothing:
# every check for that surface is recorded as `unavailable` with a reason. It
# does NOT fall back to simulated answers — simulated data exists only in the
# seeded demo workspace, which never calls a provider.
# ---------------------------------------------------------------------------

# --- Required ---------------------------------------------------------------

# --- Database ---------------------------------------------------------------
#
# Two connection strings, because two kinds of work need different things.
#
# DATABASE_URL is runtime traffic. Point it at a POOLED endpoint if your
# provider offers one (PgBouncer, Neon pooler, Supabase pooler, RDS Proxy).
# Pooling is what keeps a serverless deployment from exhausting connections.
#
# DIRECT_URL is session-dependent work: migrations, pg_dump, pg_restore and
# administration. A transaction-mode pooler multiplexes statements across
# backends, which breaks advisory locks, temp tables, prepared statements and
# SET — all of which migrations use. Running a migration through a pooler fails
# in ways that look random and intermittent.
#
# IF YOUR PROVIDER HAS NO SEPARATE DIRECT ENDPOINT, SET BOTH TO THE SAME VALUE.
# Prisma requires DIRECT_URL once the schema declares it: leaving it unset is a
# hard error ("Environment variable not found: DIRECT_URL"), not a fallback.
#
# Apply the schema with `npm run db:deploy` (prisma migrate deploy). Never with
# `prisma db push` — that bypasses migration history. See
# docs/operations-runbook.md section 2.
#
# The migrations qualify every object as "public"."Table", so the target
# database must use the `public` schema.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Signs session cookies. At least 32 characters; the app refuses to boot in
# production without it. Generate one with:  openssl rand -base64 48
AUTH_SECRET=""

# --- Recommended ------------------------------------------------------------

# Canonical URL, used for sitemaps, canonicals and Open Graph tags.
NEXT_PUBLIC_SITE_URL="https://ranklogicsupertool.com"

# Encrypts stored credentials (WordPress application passwords) at rest.
# Falls back to AUTH_SECRET when unset. Rotating either invalidates stored
# credentials, which then have to be re-entered.
ENCRYPTION_KEY=""

# Authorises /api/cron/run-checks. Scheduled runs stay disabled until this is
# set — an open endpoint could burn your provider quota. Point a scheduler at
# the endpoint hourly; it works out which projects are actually due.
#   curl -H "X-Cron-Secret: $CRON_SECRET" https://yourdomain.com/api/cron/run-checks
CRON_SECRET=""

# --- Billing (optional) -----------------------------------------------------
# Without these the app runs in self-hosted mode: billing is disabled and every
# feature is unlocked. With them, entitlements follow the Stripe subscription
# and a lapsed workspace drops to read-and-export only.

STRIPE_SECRET_KEY=""
# From the Stripe CLI (`stripe listen`) or the dashboard webhook settings.
# Without it the webhook refuses to run rather than trusting unsigned events.
STRIPE_WEBHOOK_SECRET=""

# One price id per plan and interval. A plan with no price cannot be checked
# out, and the billing page says so rather than failing at Stripe.
STRIPE_PRICE_STARTER_MONTHLY=""
STRIPE_PRICE_STARTER_ANNUAL=""
STRIPE_PRICE_GROWTH_MONTHLY=""
STRIPE_PRICE_GROWTH_ANNUAL=""
STRIPE_PRICE_SCALE_MONTHLY=""
STRIPE_PRICE_SCALE_ANNUAL=""

# --- Email (optional) -------------------------------------------------------
# Set one provider. With neither, mail is logged to the server console instead
# of being silently dropped — fine in development, but password reset will not
# reach real users, so set one before launch.

RESEND_API_KEY=""
POSTMARK_SERVER_TOKEN=""
POSTMARK_MESSAGE_STREAM="outbound"

# Must be a domain you have verified with the provider.
EMAIL_FROM="Rank Logic SuperTool <hello@ranklogicsupertool.com>"

# --- Answer engines (optional) ----------------------------------------------
# Set a key to make that surface measurable. Each is independent: you can run
# three connected and leave the rest unavailable. An unconnected surface is
# skipped and recorded as `unavailable`, and its checks are excluded from your
# rates — never counted as "the assistant did not name you".

OPENAI_API_KEY=""        # ChatGPT      (gpt-4o-search-preview)
PERPLEXITY_API_KEY=""    # Perplexity   (sonar-pro)
ANTHROPIC_API_KEY=""     # Claude       (claude-sonnet-4-5)
GOOGLE_AI_API_KEY=""     # Gemini       (gemini-2.0-flash)
XAI_API_KEY=""           # Grok         (grok-3)

# Google AI Mode has no key here on purpose. It has no official API, and no
# compliant third-party source is wired up, so it is marked unavailable in the
# engine registry and never called. It was previously answered by the Gemini
# developer API using SERP_API_KEY — a different surface with different
# retrieval — and that mapping has been removed rather than relabelled.

# --- Keyword data providers (optional) --------------------------------------
# Without one of these, keyword volume, difficulty and CPC are modelled
# in-product. Modelled rows are labelled "est." in the UI and carry a
# dataSource of "estimated" in exports, so they are never presented as
# measurements. Even with a provider connected, difficulty is labelled
# "blended": no provider publishes organic difficulty, so it mixes the
# provider's paid competition index with the in-product model. Both halves of
# the DataForSEO credential are required.

DATAFORSEO_LOGIN=""
DATAFORSEO_PASSWORD=""
SEMRUSH_API_KEY=""
GOOGLE_SEARCH_CONSOLE_CREDENTIALS=""

# --- Phase 2: production posture -------------------------------------------

# How many proxies sit in front of this process. Each trusted proxy appends one
# entry to X-Forwarded-For, so this decides which entry can be believed.
#
# Default 0 means the header is IGNORED and rate limiting keys on the socket.
# Setting it too LOW makes every caller share one bucket (annoying).
# Setting it too HIGH lets a caller pick their own bucket (dangerous).
# When unsure, set it too low.
TRUSTED_PROXY_COUNT="0"

# Extra CORS origins beyond the sites customers have actually connected.
# Comma-separated, scheme and host only. Never "*".
CORS_ALLOWED_ORIGINS=""

# Bearer token for the detailed /api/health view. Unset means the detailed view
# is unavailable rather than public.
HEALTH_TOKEN=""
