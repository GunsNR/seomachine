// Rank Logic SuperTool data model.
//
// PostgreSQL, with a reviewed migration history under prisma/migrations.
// Phase 2 replaced the previous SQLite + `db push` posture: `db push` mutates a
// schema with no recorded, reviewable, reversible step, which is acceptable
// while prototyping and unacceptable once real customer data exists. See
// docs/architecture-decision-log.md ADR-009 and ADR-014.

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"

  /// Runtime traffic. Point this at a pooled endpoint where the provider
  /// offers one (PgBouncer, Neon pooler, Supabase pooler, RDS Proxy).
  url = env("DATABASE_URL")

  /// Session-dependent work: migrations, pg_dump, pg_restore, administration.
  ///
  /// A transaction-mode pooler multiplexes statements across backends, which
  /// breaks anything relying on session state — advisory locks, temp tables,
  /// prepared statements, `SET`. Migrations use all of those, so running them
  /// through a pooler fails in ways that look random.
  ///
  /// Prisma REQUIRES this variable once declared: a missing DIRECT_URL is a
  /// hard schema-load error, not a fallback to `url`. Where a provider has no
  /// separate direct endpoint, set it to the same value as DATABASE_URL. That
  /// keeps this provider-neutral rather than encoding one vendor's topology.
  directUrl = env("DIRECT_URL")
}

model User {
  id           String               @id @default(cuid())
  email        String               @unique
  name         String
  passwordHash String
  role         String               @default("owner")
  createdAt    DateTime             @default(now())
  memberships  Membership[]
  resetTokens  PasswordResetToken[]
  sessions     Session[]
}

/// Single-use, expiring password reset token. Only the hash is stored, so a
/// database leak does not hand out working reset links.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Records a processed Stripe event so a redelivered webhook is a no-op.
model ProcessedWebhookEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())

  @@index([processedAt])
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  /// Entitlement tier. Written by the Stripe webhook, never by the client.
  plan      String   @default("starter")
  /// "live" for every real workspace; "demo" only for the seeded sample org.
  /// Simulated observations may exist under "demo" and nowhere else.
  dataMode  String   @default("live")
  createdAt DateTime @default(now())

  // --- Billing -------------------------------------------------------------
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  /// Mirrors Stripe: trialing | active | past_due | canceled | incomplete | none
  subscriptionStatus   String    @default("trialing")
  /// When the current paid period or trial ends.
  currentPeriodEnd     DateTime?
  trialEndsAt          DateTime?
  /// Set when the customer cancels but the period has not yet elapsed.
  cancelAtPeriodEnd    Boolean   @default(false)
  /// First moment Stripe reported `past_due`. A failed payment opens a bounded
  /// grace window rather than indefinite full access — see lib/billing.ts.
  pastDueSince         DateTime?

  members  Membership[]
  projects Project[]
}

model Membership {
  id     String       @id @default(cuid())
  userId String
  orgId  String
  role   String       @default("owner")
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
}

model Project {
  id          String   @id @default(cuid())
  orgId       String
  name        String
  domain      String
  description String   @default("")
  country     String   @default("us")
  /// Denormalised from the owning organization so every per-project query can
  /// scope demo data out without a join. Always equal to org.dataMode.
  dataMode    String   @default("live")
  createdAt   DateTime @default(now())

  org         Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  keywords    Keyword[]
  prompts     AiPrompt[]
  competitors Competitor[]
  audits      AuditRun[]
  articles    Article[]
  briefs      ContentBrief[]
  backlinks   Backlink[]
  leads       Lead[]
  connections SiteConnection[]
  apiKeys     ApiKey[]
  runs        MeasurementRun[]

  @@index([orgId])
}

model Keyword {
  id               String   @id @default(cuid())
  projectId        String
  phrase           String
  volume           Int      @default(0)
  difficulty       Int      @default(0)
  cpc              Float    @default(0)
  intent           String   @default("informational")
  trend            String   @default("[]") // JSON array of 12 monthly volumes
  /// Summary provenance: "measured" only when every field came from a
  /// provider, otherwise "blended" or "estimated".
  dataSource       String   @default("estimated")
  /// Per-field provenance, because one row can mix measured and modelled
  /// inputs. Each is "measured" | "estimated" | "blended".
  volumeSource     String   @default("estimated")
  difficultySource String   @default("estimated")
  cpcSource        String   @default("estimated")
  /// Provider that supplied the measured fields, e.g. "dataforseo".
  dataProvider     String   @default("")
  createdAt        DateTime @default(now())

  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  snapshots RankSnapshot[]

  @@unique([projectId, phrase])
  @@index([projectId])
}

model RankSnapshot {
  id         String   @id @default(cuid())
  keywordId  String
  engine     String   @default("google")
  position   Int // 0 == not in top 100
  url        String   @default("")
  capturedAt DateTime @default(now())

  keyword Keyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@index([keywordId, capturedAt])
}

/// A question a real buyer would ask an AI assistant. Visibility is measured
/// by how often the brand is named or cited in the answers.
model AiPrompt {
  id        String   @id @default(cuid())
  projectId String
  text      String
  cluster   String   @default("general")
  intent    String   @default("informational")
  createdAt DateTime @default(now())

  project Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  checks  AiCheck[]

  @@index([projectId])
}

model AiCheck {
  id             String   @id @default(cuid())
  promptId       String
  engine         String // chatgpt | perplexity | claude | gemini | grok | google-ai-mode
  brandMentioned Boolean  @default(false)
  brandCited     Boolean  @default(false)
  mentionRank    Int      @default(0) // 1-based order the brand appears among named vendors
  sentiment      String   @default("neutral")
  shareOfVoice   Float    @default(0)
  citedUrls      String   @default("[]") // JSON array
  competitors    String   @default("[]") // JSON array of competitor domains named
  excerpt        String   @default("")
  /// live | simulated | failed | unavailable. Only live and simulated rows
  /// carry an answer; failed and unavailable rows are missing observations and
  /// must never be counted as "the brand was absent".
  ///
  /// Defaults to "unavailable" on purpose. Every writer sets this explicitly,
  /// so the default only ever applies to a row that predates this column — and
  /// a row whose provenance is unknown must not be counted as a live
  /// measurement. Failing closed here means an un-backfilled legacy row is
  /// excluded from the numbers rather than silently inflating them.
  status         String   @default("unavailable")
  /// Populated for failed/unavailable rows: auth | rate_limit | quota |
  /// timeout | network | empty_response | http_error | no_credential |
  /// surface_unavailable | unsupported_engine | unknown.
  errorCategory  String   @default("")
  /// Operator-facing failure detail. Never contains a credential.
  errorDetail    String   @default("")
  /// Exact model asked, when a call was made.
  model          String   @default("")
  latencyMs      Int      @default(0)
  runAt          DateTime @default(now())

  prompt AiPrompt @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@index([promptId, runAt])
  @@index([engine, runAt])
}

model Competitor {
  id        String   @id @default(cuid())
  projectId String
  domain    String
  label     String   @default("")
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, domain])
}

model AuditRun {
  id           String    @id @default(cuid())
  projectId    String
  status       String    @default("running")
  score        Int       @default(0)
  pagesCrawled Int       @default(0)
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues  AuditIssue[]

  @@index([projectId, startedAt])
}

model AuditIssue {
  id       String @id @default(cuid())
  auditId  String
  url      String
  code     String
  severity String @default("notice") // critical | warning | notice
  title    String
  detail   String @default("")
  category String @default("onpage") // crawlability | onpage | performance | schema | ai-readiness

  audit AuditRun @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId, severity])
}

model ContentBrief {
  id            String   @id @default(cuid())
  projectId     String
  topic         String
  targetKeyword String
  intent        String   @default("informational")
  outline       String   @default("[]") // JSON array of H2/H3
  questions     String   @default("[]") // JSON array of AI-cited questions to answer
  targetWords   Int      @default(1800)
  status        String   @default("ready")
  createdAt     DateTime @default(now())

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  articles Article[]
}

model Article {
  id              String    @id @default(cuid())
  projectId       String
  briefId         String?
  title           String
  slug            String
  body            String    @default("")
  metaTitle       String    @default("")
  metaDescription String    @default("")
  status          String    @default("draft") // draft | review | scheduled | published
  seoScore        Int       @default(0)
  aiReadyScore    Int       @default(0)
  readability     Float     @default(0)
  wordCount       Int       @default(0)
  wpPostId        Int?
  publishedUrl    String    @default("")
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brief   ContentBrief? @relation(fields: [briefId], references: [id])

  @@unique([projectId, slug])
  @@index([projectId, status])
}

model Backlink {
  id        String   @id @default(cuid())
  projectId String
  sourceUrl String
  targetUrl String
  anchor    String   @default("")
  dofollow  Boolean  @default(true)
  authority Int      @default(0)
  firstSeen DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

/// A visit or enquiry attributed back to an AI assistant or organic search.
model Lead {
  id         String   @id @default(cuid())
  projectId  String
  source     String   @default("ai") // ai | organic | direct
  engine     String   @default("")
  landingUrl String   @default("")
  email      String   @default("")
  name       String   @default("")
  value      Float    @default(0)
  status     String   @default("new")
  capturedAt DateTime @default(now())

  /// Where the referrer that produced `engine` came from:
  ///   header  — the browser's own Referer header on this request
  ///   body    — a value the caller put in the payload
  ///   none    — no referrer at all
  /// Phase 2 stopped accepting a caller-supplied `engine` outright, but even a
  /// referrer is client-controlled, so the origin of the evidence is recorded
  /// alongside the conclusion rather than being flattened away.
  referrerSource      String  @default("none")
  /// True only when the engine was derived from the browser's Referer header.
  /// Everything else is a claim, and the difference is not cosmetic: an
  /// unverified attribution must never be counted as a measured one.
  attributionVerified Boolean @default(false)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, capturedAt])
}

/// A connected publishing target — today WordPress via the SuperTool plugin.
model SiteConnection {
  id          String    @id @default(cuid())
  projectId   String
  platform    String    @default("wordpress")
  siteUrl     String
  username    String    @default("")
  appPassword String    @default("")
  status      String    @default("pending")
  lastSyncAt  DateTime?
  createdAt   DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ApiKey {
  id         String    @id @default(cuid())
  projectId  String
  label      String    @default("WordPress plugin")
  prefix     String
  hashedKey  String
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  /// Comma-separated scope list. A key may do only what it names.
  /// Empty means the legacy full-read set, preserved so existing plugin
  /// installations keep working; new keys are always issued with explicit scopes.
  scopes String @default("")

  /// Set when the key is revoked. A revoked key never authenticates again,
  /// and the row is kept so the audit trail survives the revocation.
  revokedAt DateTime?
  /// Optional expiry. A key past this instant never authenticates.
  expiresAt DateTime?

  /// Rolling per-day request budget. 0 means unlimited.
  dailyQuota Int    @default(0)
  /// Requests counted inside the current UTC day.
  usageCount Int    @default(0)
  /// The UTC day `usageCount` belongs to, as YYYY-MM-DD.
  usageDay   String @default("")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([prefix])
}

/// A marketing-site enquiry.
///
/// Deliberately unrelated to Organization, Project or Lead: a public,
/// unauthenticated form must never be able to write into a customer's
/// workspace or inflate their lead numbers. Nothing in the app reads this
/// model into a tenant view.
model ContactInquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String   @default("")
  website   String   @default("")
  message   String
  /// Coarse source label for triage only, e.g. "contact-form".
  channel   String   @default("contact-form")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// One execution of one prompt set against one project.
///
/// The unit of reporting. Every rate the product displays is computed inside a
/// single run, identified by this row's id — never by grouping on a date. Two
/// runs on the same UTC day are two runs; see docs/measurement-spec.md §7 for
/// why merging them was wrong in four separate ways.
///
/// The row is written before the first provider call, so an interrupted
/// process leaves an honest partial run rather than nothing.
model MeasurementRun {
  id        String @id @default(cuid())
  orgId     String
  projectId String

  /// manual | scheduled | backfill
  trigger  String @default("manual")
  /// live | demo. A demo run never calls a provider; a live run never simulates.
  dataMode String @default("live")
  /// queued | running | partial | completed | failed | cancelled
  status   String @default("queued")

  /// Content hash of the prompt texts at the moment this run started. Two runs
  /// with different versions measured with different instruments.
  promptSetVersion   String @default("")
  /// Which revision of docs/measurement-spec.md produced these numbers.
  methodologyVersion String @default("m1")
  /// Repetitions per (prompt, engine) pair in this run.
  samplesPerPair     Int    @default(1)

  /// The locale context the run declared. Not proof the provider honoured it.
  localeTag  String @default("en-US")
  regionCode String @default("US")

  /// attempted = expectedObservations once the run finishes fanning out.
  expectedObservations Int @default(0)
  /// live + simulated. The denominator of every rate.
  observedCount        Int @default(0)
  failedCount          Int @default(0)
  unavailableCount     Int @default(0)

  /// Estimated from a local price table, never reconciled against an invoice.
  totalCostUsd       Float @default(0)
  totalInputTokens   Int   @default(0)
  totalOutputTokens  Int   @default(0)
  /// How many observations actually reported token usage. 0 tokens means "not
  /// reported", not "none used".
  usageReportedCount Int   @default(0)

  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  /// Operator-facing failure detail. Never contains a credential.
  error      String    @default("")

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  observations Observation[]

  @@index([projectId, startedAt])
  @@index([orgId, startedAt])
  @@index([status])
}

/// One attempt to ask one prompt, on one engine, at one sample index.
///
/// Immutable by contract: the repository layer only ever creates these rows.
/// A correction is a new run, never an edit. The compound uniqueness constraint
/// is what makes retrying a run idempotent — a retry fills gaps and cannot
/// duplicate an observation that already landed.
model Observation {
  id    String @id @default(cuid())
  runId String

  /// The prompt row this came from. Prompts can be edited or deleted, so the
  /// snapshot below — not this id — is the record of what was actually asked.
  promptId           String
  promptTextSnapshot String @default("")
  promptVersion      String @default("")
  promptCluster      String @default("")

  engine             String
  vendor             String  @default("")
  accessMethod       String  @default("")
  /// The model identifier SuperTool sent. Always known.
  modelRequested     String  @default("")
  /// The model identifier the provider said it used. Empty when the provider
  /// does not return one — never inferred from the request.
  modelReturned      String  @default("")
  /// Whether the request enabled the vendor's web-retrieval tool. A property of
  /// our own code, so known with certainty.
  groundingRequested Boolean @default(false)
  /// Whether the response actually carried retrieval evidence.
  groundingConfirmed Boolean @default(false)

  /// 0-based repetition of this (prompt, engine) pair within the run.
  sampleIndex Int    @default(0)
  localeTag   String @default("en-US")
  regionCode  String @default("US")

  /// live | simulated | failed | unavailable.
  /// Defaults to unavailable so a row of unknown provenance fails closed.
  status        String @default("unavailable")
  errorCategory String @default("")
  errorDetail   String @default("")

  latencyMs        Int   @default(0)
  inputTokens      Int   @default(0)
  outputTokens     Int   @default(0)
  /// Estimated from a local price table. Labelled as an estimate everywhere.
  estimatedCostUsd Float @default(0)

  // --- Parsed outcomes. Meaningful only when status is live or simulated. ---
  brandMentioned  Boolean @default(false)
  brandCited      Boolean @default(false)
  mentionRank     Int     @default(0)
  sentiment       String  @default("neutral")
  shareOfVoice    Float   @default(0)
  citedUrls       String  @default("[]")
  competitors     String  @default("[]")
  evidenceExcerpt String  @default("")
  /// Hash of the raw answer, so a stored number can be tied to the exact text
  /// that produced it without keeping the full text in this table.
  rawAnswerHash   String  @default("")

  parserVersion      String   @default("p1")
  methodologyVersion String   @default("m1")
  observedAt         DateTime @default(now())

  run MeasurementRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, promptId, engine, sampleIndex])
  @@index([runId])
  @@index([engine, observedAt])
}

// ---------------------------------------------------------------------------
// Phase 2: session revocation, durable jobs, shared rate limiting
// ---------------------------------------------------------------------------

/// A server-side session record.
///
/// The session cookie is still a signed JWT, but it now carries a session id
/// that is checked against this table on every request. That is the difference
/// between "the cookie is deleted from this browser" and "this session can no
/// longer be used" — before Phase 2, logging out removed the cookie while the
/// token stayed valid for the rest of its fourteen days, so a copy taken before
/// logout still authenticated.
model Session {
  id            String    @id @default(cuid())
  userId        String
  orgId         String
  createdAt     DateTime  @default(now())
  expiresAt     DateTime
  /// Set the moment the session stops being usable. Never deleted, so the
  /// record of the revocation survives.
  revokedAt     DateTime?
  /// Why it was revoked: logout | password-change | password-reset | admin | expired
  revokedReason String    @default("")
  lastSeenAt    DateTime  @default(now())
  /// Coarse client fingerprint for the account's session list. Never a secret.
  userAgent     String    @default("")
  ipHash        String    @default("")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// A durable unit of background work.
///
/// Phase 1 ran measurement in-process: a crash mid-run lost whatever had not
/// been written, and nothing retried. This table makes the work itself durable
/// and, critically, *claimable* — a worker takes a lease rather than simply
/// reading a row, so two workers cannot run the same job.
model Job {
  id        String @id @default(cuid())
  /// Job family, e.g. measurement-run | site-audit | wordpress-publish.
  kind      String
  /// Tenant this job belongs to. Every claim is scoped by it.
  orgId     String
  projectId String @default("")

  /// queued | running | succeeded | failed | cancelled | dead
  status   String @default("queued")
  /// Lower runs first; ties break on runAfter then createdAt.
  priority Int    @default(100)

  /// JSON payload. Never contains a credential — see lib/jobs/queue.ts.
  payload String @default("{}")

  /// Caller-supplied dedupe key. A second enqueue with the same key returns
  /// the existing job instead of creating a duplicate.
  idempotencyKey String?

  attempts    Int      @default(0)
  maxAttempts Int      @default(5)
  /// Not eligible to run before this instant. Backoff moves it forward.
  runAfter    DateTime @default(now())

  /// Lease held by the worker currently running this job. A lease that expires
  /// without completion makes the job claimable again — that is the recovery
  /// path for a worker that died mid-job.
  lockedBy       String?
  lockedAt       DateTime?
  leaseExpiresAt DateTime?

  /// Set by a cancellation request. A running job checks it at each checkpoint.
  cancelRequestedAt DateTime?

  lastError     String @default("")
  /// Failure classification, so a permanent failure is not retried forever.
  errorCategory String @default("")

  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  @@unique([idempotencyKey])
  @@index([status, runAfter])
  @@index([orgId])
  @@index([kind, status])
  @@index([leaseExpiresAt])
}

/// A named mutual-exclusion lease.
///
/// Distinct from a job lease: this guards a *recurring activity* rather than a
/// unit of work — the scheduled-run sweep must not run twice concurrently even
/// though it enqueues many jobs. Holder writes its identity and an expiry;
/// an expired lock is takeable, so a crashed holder does not block forever.
model JobLock {
  key        String   @id
  holder     String
  acquiredAt DateTime @default(now())
  expiresAt  DateTime

  @@index([expiresAt])
}

/// Shared fixed-window rate-limit counter.
///
/// The in-memory limiter is per-process, so behind N instances the real limit
/// was N x the configured one. This makes the window shared. It is deliberately
/// a plain table rather than Redis: it needs no new infrastructure, and the
/// contention profile of these endpoints does not warrant any.
model RateLimitCounter {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}
